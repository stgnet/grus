# The Studio in the starting setup: a live, full copy of everything, as a
# non-voting member. It serves no web traffic of its own (no http_addr or
# https_addr); a VPS may still pass it a page for a group the VPS doesn't
# hold. It registers through the VPS on its first start, and each log's
# leader then adds it.

node_id  = studio
node_num = 2
# On the Studio's own disk, not the NAS: SQLite needs local-disk locking.
# The NAS gets the daily backups (deploy/grus-backup.sh).
data_dir = /usr/local/var/grus

cluster_addr = :7946
advertise    = studio.example.net:7946
# Holds every group, as a non-voter: its home connection can drop without
# stalling anything.
full         = true
join         = vps1.nfb.group:7946

tls_ca   = /etc/grus/cluster/ca.crt
tls_cert = /etc/grus/cluster/studio.crt
tls_key  = /etc/grus/cluster/studio.key

# AI: the Studio runs a model through Ollama on the same machine. It works
# the job queue (digests, link checks, notes) and answers searches for
# every node (they find it in the node map). Which model, and its context
# window, are global settings (ai_model, ai_context on the admin page):
# pick one with `grus bench-llm` (docs/operations.md), and pull it into
# Ollama here first.
ai_url = http://127.0.0.1:11434
