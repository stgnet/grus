# grus.conf: one "key = value" per line; # starts a comment.
# Keys that take a list (join, domain, operator) are repeated.
#
# grus.conf holds only what's particular to this node. Everything else is
# the global level, kept in site.db, the same on every node, and changed on
# the admin page: the list of domains (all equal, any node answers any of
# them), mail, operators, AI settings, and every group with its settings.
#
# This example is the VPS in the starting setup (plan section 8, "Where it
# starts"): the first node, serving every group, with the Studio as a
# full copy. deploy/studio.conf.example is the Studio's side.

# This node's stable id in the cluster, and its number for ids (0-1023,
# different on every node).
node_id  = n1
node_num = 1

data_dir = /var/lib/grus

# Web. Port 80 answers Let's Encrypt and redirects to HTTPS.
http_addr  = :80
https_addr = :443

# For a laptop: plain HTTP, no certificates. Use a domain like
# grus.localhost (browsers send *.localhost to 127.0.0.1) and open
# http://grus.localhost:8080/.
# dev = true
# http_addr = :8080

# Cluster: node-to-node mutual TLS on one port.
cluster_addr = :7946
advertise    = vps1.nfb.group:7946
# New groups are placed on nodes with voter = true (a VPS that serves
# pages); the first node always is one. A small VPS that holds only the
# groups placed on it sets neither voter nor full.
voter        = true
# Every node but the first sets join (repeatable): an existing node to copy
# site.db from the first time it starts. After that the node map (site.db)
# is how the nodes find each other.
# join = vps2.nfb.group:7946

tls_ca   = /etc/grus/cluster/ca.crt
tls_cert = /etc/grus/cluster/n1.crt
tls_key  = /etc/grus/cluster/n1.key

# ---------------------------------------------------------------------
# Seeds. Everything below is used once, when the cluster is first
# created (or first started after upgrading to the global level), to fill
# in the global settings. After that the admin page is the truth and
# these lines are ignored; they can be deleted.

# The site's first domain (repeat for more). The first node needs one.
domain = nfb.group

# Accounts with these emails become site operators when they sign in.
operator = scott@stg.net

# Let's Encrypt's contact address.
acme_email = scott@stg.net

# The SMTP relay for sign-in and notification email. A domain can also
# have its own, on the admin page. Without one, emails are printed to the
# log instead (fine for a laptop, useless in production): until it's set,
# find the first sign-in link with `journalctl -u grus`.
# smtp_host = smtp.example.com
# smtp_port = 587
# smtp_user = login@nfb.group
# smtp_pass = change-me
# The first domain's sender (default login@<domain>).
# mail_from = login@nfb.group

# Quick answers per member per day (default 20), and the UTC hours of the
# nightly FAQ batch (8) and the daily email digest (12).
# ask_daily_limit = 20
# faq_hour = 8
# digest_hour = 12
