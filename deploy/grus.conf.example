# grus.conf: one "key = value" per line; # starts a comment.
# Keys that take a list (peer, operator) are repeated.
#
# This example is the VPS in the starting setup (plan section 8, "Where it
# starts"): the only voter, serving every group, with the Studio as a
# non-voting full copy. deploy/studio.conf.example is the Studio's side.

# This node's stable id in the cluster, and its number for ids (0-1023,
# different on every node).
node_id  = n1
node_num = 1

data_dir = /var/lib/grus

# Seeds the domains table the first time the cluster starts. After that,
# change domains on the admin page (the table is the truth).
primary_domain = nfb.group

# Web. Port 80 answers Let's Encrypt and redirects to HTTPS.
http_addr  = :80
https_addr = :443
acme_email = scott@stg.net

# For a laptop: plain HTTP, no certificates. Use a primary like
# grus.localhost (browsers send *.localhost to 127.0.0.1) and open
# http://grus.localhost:8080/.
# dev = true
# http_addr = :8080

# Cluster: node-to-node mutual TLS on one port.
cluster_addr = :7946
advertise    = vps1.nfb.group:7946
# Only on the very first start of the first node; harmless afterwards.
bootstrap    = true
# Non-voters the leader keeps in the cluster: "<id> <host:port>".
peer = studio studio.example.net:7946

tls_ca   = /etc/grus/cluster/ca.crt
tls_cert = /etc/grus/cluster/n1.crt
tls_key  = /etc/grus/cluster/n1.key

# Mail relay for sign-in emails. Without smtp_host, emails are printed to
# the log instead (fine for a laptop, useless in production).
smtp_host = smtp.example.com
smtp_port = 587
smtp_user = login@nfb.group
smtp_pass = change-me
mail_from = login@nfb.group

# Accounts with these emails become site operators when they sign in.
operator = scott@stg.net

# AI (plan section 9). The VPS runs no model: searches and background jobs
# go to the nodes listed here (their cluster addresses). Without a worker,
# search shows plain results and nothing is summarized or linked; the site
# works the same otherwise.
worker = studio.example.net:7946
# Quick answers per member per day (0 = the default, 20).
# ask_daily_limit = 20
# Hour (UTC, 0-23) the nightly FAQ batch is queued.
# faq_hour = 8
